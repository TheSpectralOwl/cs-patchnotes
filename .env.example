# Cloudflare remote-managed tunnel token.
TUNNEL_TOKEN=

# High-entropy bearer token for the archive API's private reload endpoint.
RELOAD_TOKEN=

# Absolute host path containing active and worktrees/<full-content-git-sha>.
CONTENT_REVISION_ROOT=

# Absolute host path of the content Git repository used by activation.
CONTENT_REPOSITORY_DIR=

# Loopback URL used by the host-side activation command.
ARCHIVE_API_URL=http://127.0.0.1:3001
